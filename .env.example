# Backend (read from the environment or backend/.env)
QUANTLAB_DATABASE_URL=sqlite:///./quantlab.db
# Free KRX data portal account (data.krx.co.kr). Needed only for KOSPI 200 / KOSDAQ 150 member history.
KRX_ID=
KRX_PW=
# Frontend: where Next.js proxies /api/* (default http://127.0.0.1:8000)
QUANTLAB_BACKEND_URL=http://127.0.0.1:8000
